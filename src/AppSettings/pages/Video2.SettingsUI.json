{
    "version": 1,
    "fileType": "SettingsUI",
    "bindings": {
        "videoSource": "QGroundControl.settingsManager.video2Settings.videoSource.rawValue",
        "autoStreamConfig": "false",
        "sourceDisabled": "videoSource === QGroundControl.settingsManager.video2Settings.disabledVideoSource",
        "isStreamSource": "true"
    },
    "groups": [
        {
            "heading": "Video Source",
            "keywords": ["video source", "camera", "stream"],
            "enableWhen": "!autoStreamConfig",
            "headingDescription": "autoStreamConfig ? qsTr(\"Mavlink camera stream is automatically configured\") : \"\"",
            "controls": [
                {
                    "setting": "video2Settings.videoSource",
                    "control": "combobox"
                }
            ]
        },
        {
            "heading": "Connection",
            "keywords": ["rtsp", "whep", "tcp", "udp", "mpegts", "video url", "stream url"],
            "showWhen": "!sourceDisabled && !autoStreamConfig",
            "controls": [
                {
                    "setting": "video2Settings.rtspUrl",
                    "showWhen": "videoSource === QGroundControl.settingsManager.video2Settings.rtspVideoSource"
                },
                {
                    "setting": "video2Settings.whepUrl",
                    "showWhen": "videoSource === QGroundControl.settingsManager.video2Settings.whepVideoSource"
                },
                {
                    "setting": "video2Settings.tcpUrl",
                    "showWhen": "videoSource === QGroundControl.settingsManager.video2Settings.tcpVideoSource"
                },
                {
                    "setting": "video2Settings.udpUrl",
                    "showWhen": "videoSource === QGroundControl.settingsManager.video2Settings.udp264VideoSource || videoSource === QGroundControl.settingsManager.video2Settings.udp265VideoSource || videoSource === QGroundControl.settingsManager.video2Settings.mpegtsVideoSource"
                }
            ]
        },
        {
            "heading": "Driving Guide",
            "keywords": ["driving guide", "trajectory", "overlay", "guide lines", "maneuvering", "clearance", "fpv"],
            "controls": [
                {
                    "setting": "video2Settings.drivingGuideEnabled"
                },
                {
                    "setting": "video2Settings.drivingGuideCameraSideOffset",
                    "enableWhen": "QGroundControl.settingsManager.video2Settings.drivingGuideEnabled.rawValue"
                },
                {
                    "setting": "video2Settings.drivingGuideCameraFrontSetback",
                    "enableWhen": "QGroundControl.settingsManager.video2Settings.drivingGuideEnabled.rawValue"
                },
                {
                    "setting": "video2Settings.drivingGuideCameraHeight",
                    "enableWhen": "QGroundControl.settingsManager.video2Settings.drivingGuideEnabled.rawValue"
                },
                {
                    "setting": "video2Settings.drivingGuideCameraTilt",
                    "enableWhen": "QGroundControl.settingsManager.video2Settings.drivingGuideEnabled.rawValue"
                },
                {
                    "setting": "video2Settings.drivingGuideCameraFov",
                    "enableWhen": "QGroundControl.settingsManager.video2Settings.drivingGuideEnabled.rawValue"
                },
                {
                    "setting": "video2Settings.drivingGuideCameraVfov",
                    "enableWhen": "QGroundControl.settingsManager.video2Settings.drivingGuideEnabled.rawValue"
                },
                {
                    "setting": "video2Settings.drivingGuideVehicleWidth",
                    "enableWhen": "QGroundControl.settingsManager.video2Settings.drivingGuideEnabled.rawValue"
                },
                {
                    "setting": "video2Settings.drivingGuideNearDistance",
                    "enableWhen": "QGroundControl.settingsManager.video2Settings.drivingGuideEnabled.rawValue"
                },
                {
                    "setting": "video2Settings.drivingGuideFarDistance",
                    "enableWhen": "QGroundControl.settingsManager.video2Settings.drivingGuideEnabled.rawValue"
                },
                {
                    "setting": "video2Settings.drivingGuideColor",
                    "enableWhen": "QGroundControl.settingsManager.video2Settings.drivingGuideEnabled.rawValue"
                },
                {
                    "setting": "video2Settings.drivingGuideLineWidth",
                    "enableWhen": "QGroundControl.settingsManager.video2Settings.drivingGuideEnabled.rawValue"
                }
            ]
        }
    ]
}
